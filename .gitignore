# The index is data, not code - 84 MB of it, rebuilt by `python -m romsrx
# index`. GitHub warns past 50 MB and refuses past 100.
romsrx.db
romsrx.db-shm
romsrx.db-wal

# Build output
build/
dist/
*.spec
build.log

# archive.org credentials, if any ever land here rather than the user folder
ia.ini
.env
.env.*
*.pem
*.key
secrets.json

# Personal state. These live in %APPDATA%\RomSrx now, but older builds wrote
# them beside the code - and push.bat stages everything, so a leftover copy
# would be published. settings.json holds your folder paths; cart.json and
# queue.json hold what you have been downloading.
settings.json
prefs.json
cart.json
queue.json
covers.json
window.json
covers/
# API keys for the optional cover services. These only ever live in the user
# folder, but so did the files above, and this list exists because "only ever"
# stopped being true once. A key published here is a key to revoke.
artwork.json
artwork-igdb-platforms.json
artcache.json
thumbs/

__pycache__/
*.py[cod]
.venv/
venv/

.vscode/
.idea/
.DS_Store
Thumbs.db
